{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "paths": { "@shared/*": ["./shared/*"] },
    "types": ["./worker-configuration.d.ts"]
  },
  "include": ["worker", "shared"],
  "exclude": ["**/*.test.ts"]
}
